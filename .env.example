# Copy to .env.local (for local dev) or set as GitHub Repository Variables/Secrets.
# Note: Only the owner's Firebase Web Config + Owner Email are needed here.
# NEVER put your Gemini API key in .env for the frontend — store it in your private
# Firestore doc via the Owner Settings UI (and optionally in GitHub Secrets as GEMINI_API_KEY
# for daily GitHub Actions auto-tagging).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Owner identity (used to distinguish Owner Mode from Guest Mode in UI)
VITE_OWNER_EMAIL=
VITE_OWNER_CF_HANDLE=shivanshx365
VITE_OWNER_LC_HANDLE=shivanshx365
VITE_OWNER_AC_HANDLE=shivanshx365
